# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/todo-app
# For MongoDB Atlas (Render deployment):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/todo-app?retryWrites=true&w=majority

# Client URL for CORS (Leave * or specify your Netlify URL)
CLIENT_URL=*
